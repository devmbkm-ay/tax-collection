# ── Backend ──────────────────────────────────────────────────────────────────

# MongoDB connection string — leave empty to fall back to SQLite
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fiscalflow

# Comma-separated allowed origins (your frontend domain)
CORS_ORIGINS=https://fiscalflow.ricardomboukou.online

# SQLite path inside the container — only used when MONGODB_URI is not set
# DB_PATH=/data/worldremit_transactions.db

# ── Frontend ─────────────────────────────────────────────────────────────────
# Compiled into the JS bundle at build time — must be set BEFORE docker build

NEXT_PUBLIC_API_URL=https://api.fiscalflow.ricardomboukou.online
